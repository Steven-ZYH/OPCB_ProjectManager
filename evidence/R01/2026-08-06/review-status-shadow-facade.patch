diff --git a/native/ReviewMachineStatusLegacyFacade.swift b/native/ReviewMachineStatusLegacyFacade.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a5c3a44b98f5645bc1e69fc4838815386cdb1c4d
--- /dev/null
+++ b/native/ReviewMachineStatusLegacyFacade.swift
@@ -0,0 +1,325 @@
+import Foundation
+
+enum ReviewMachineStatusFacadeMode: Equatable {
+    case legacyOnly
+    case shadow
+
+    static func from(environment: [String: String] = ProcessInfo.processInfo.environment) -> ReviewMachineStatusFacadeMode {
+        environment["OPCB_REVIEW_MACHINE_STATUS_FACADE_MODE"]?.lowercased() == "shadow" ? .shadow : .legacyOnly
+    }
+}
+
+private struct ReviewMachineStatusCacheV1: Decodable {
+    struct Machine: Decodable {
+        let thermalState: String
+        let temperatureAvailable: Bool
+        let powerAvailable: Bool
+
+        enum CodingKeys: String, CodingKey {
+            case thermalState = "thermal_state"
+            case temperatureAvailable = "temperature_available"
+            case powerAvailable = "power_available"
+        }
+    }
+
+    struct Worker: Decodable {
+        let queueDepth: Int
+        let activeJobCount: Int
+        let phase: String?
+
+        enum CodingKeys: String, CodingKey {
+            case queueDepth = "queue_depth"
+            case activeJobCount = "active_job_count"
+            case phase
+        }
+    }
+
+    struct QuotaWindow: Decodable {
+        let kind: String
+        let remainingPercent: Double
+        let windowDurationMinutes: Int
+        let resetsAt: Int64?
+
+        enum CodingKeys: String, CodingKey {
+            case kind
+            case remainingPercent = "remaining_percent"
+            case windowDurationMinutes = "window_duration_mins"
+            case resetsAt = "resets_at"
+        }
+    }
+
+    struct QuotaPrediction: Decodable {
+        let predictedAt: Int64
+        let windowKind: String
+        let source: String
+
+        enum CodingKeys: String, CodingKey {
+            case predictedAt = "predicted_at"
+            case windowKind = "window_kind"
+            case source
+        }
+    }
+
+    struct Codex: Decodable {
+        let processRunning: Bool
+        let quotaRemainingPercent: Double?
+        let quotaAvailable: Bool
+        let quotaWindows: [QuotaWindow]?
+        let quotaResetPrediction: QuotaPrediction?
+
+        enum CodingKeys: String, CodingKey {
+            case processRunning = "process_running"
+            case quotaRemainingPercent = "quota_remaining_percent"
+            case quotaAvailable = "quota_available"
+            case quotaWindows = "quota_windows"
+            case quotaResetPrediction = "quota_reset_prediction"
+        }
+    }
+
+    struct News: Decodable {
+        struct Item: Decodable {}
+        let status: String
+        let latest: Item?
+        let latestQuotaSignal: Item?
+
+        enum CodingKeys: String, CodingKey {
+            case status, latest
+            case latestQuotaSignal = "latest_quota_signal"
+        }
+    }
+
+    let schemaVersion: Int
+    let sampledAt: String
+    let receivedAt: Date
+    let machine: Machine
+    let worker: Worker
+    let codex: Codex
+    let news: News?
+
+    enum CodingKeys: String, CodingKey {
+        case schemaVersion = "schema_version"
+        case sampledAt = "sampled_at"
+        case receivedAt = "received_at"
+        case machine, worker, codex, news
+    }
+
+    func projection(rawData: Data, now: Date, freshness: TimeInterval) throws -> SnapshotProjection {
+        guard schemaVersion == 1 else {
+            throw DomainValidationError.unsupportedSchemaVersion(schemaVersion)
+        }
+        var fields = try CanonicalJSONFieldProjector.flatten(rawData)
+        appendDerivedFields(
+            to: &fields,
+            now: now,
+            freshness: freshness,
+            receivedAt: receivedAt,
+            thermalState: machine.thermalState,
+            temperatureAvailable: machine.temperatureAvailable,
+            powerAvailable: machine.powerAvailable,
+            queueDepth: worker.queueDepth,
+            activeJobCount: worker.activeJobCount,
+            workerPhase: worker.phase,
+            processRunning: codex.processRunning,
+            quotaAvailable: codex.quotaAvailable,
+            quotaRemainingPercent: codex.quotaRemainingPercent,
+            quotaWindows: codex.quotaWindows?.map {
+                ($0.kind, $0.remainingPercent, $0.windowDurationMinutes, $0.resetsAt)
+            },
+            prediction: codex.quotaResetPrediction.map {
+                ($0.predictedAt, $0.windowKind, $0.source)
+            },
+            newsStatus: news?.status,
+            hasLatestNews: news?.latest != nil,
+            hasQuotaSignal: news?.latestQuotaSignal != nil
+        )
+        return SnapshotProjection(fields: fields)
+    }
+}
+
+private func appendDerivedFields(
+    to fields: inout [String: ShadowFieldValue],
+    now: Date,
+    freshness: TimeInterval,
+    receivedAt: Date,
+    thermalState: String,
+    temperatureAvailable: Bool,
+    powerAvailable: Bool,
+    queueDepth: Int,
+    activeJobCount: Int,
+    workerPhase: String?,
+    processRunning: Bool,
+    quotaAvailable: Bool,
+    quotaRemainingPercent: Double?,
+    quotaWindows: [(String, Double, Int, Int64?)]?,
+    prediction: (Int64, String, String)?,
+    newsStatus: String?,
+    hasLatestNews: Bool,
+    hasQuotaSignal: Bool
+) {
+    fields["derived/isFresh"] = .value(String(now.timeIntervalSince(receivedAt) < freshness))
+    fields["derived/hasActiveWork"] = .value(String(activeJobCount > 0 || processRunning))
+    fields["derived/thermalState"] = .value(thermalState)
+    fields["derived/temperatureAvailable"] = .value(String(temperatureAvailable))
+    fields["derived/powerAvailable"] = .value(String(powerAvailable))
+    fields["derived/worker/queueDepth"] = .value(String(queueDepth))
+    fields["derived/worker/activeJobCount"] = .value(String(activeJobCount))
+    fields["derived/worker/phase"] = workerPhase.map(ShadowFieldValue.value) ?? .missing
+    fields["derived/codex/processRunning"] = .value(String(processRunning))
+    fields["derived/quota/available"] = .value(String(quotaAvailable))
+    fields["derived/quota/remainingPercent"] = quotaRemainingPercent.map { .value(String($0)) } ?? .missing
+
+    let limitingWindow = quotaWindows?.min {
+        if $0.1 == $1.1 { return $0.2 < $1.2 }
+        return $0.1 < $1.1
+    }
+    let resetEpoch = prediction?.0 ?? limitingWindow?.3
+    let resetWindow = prediction?.1 ?? limitingWindow?.0
+    let resetSource = prediction?.2 ?? (limitingWindow == nil ? nil : "window")
+    fields["derived/quota/resetEpoch"] = resetEpoch.map { .value(String($0)) } ?? .missing
+    fields["derived/quota/resetWindow"] = resetWindow.map(ShadowFieldValue.value) ?? .missing
+    fields["derived/quota/resetSource"] = resetSource.map(ShadowFieldValue.value) ?? .missing
+    fields["derived/news/status"] = newsStatus.map(ShadowFieldValue.value) ?? .missing
+    fields["derived/news/hasLatest"] = .value(String(hasLatestNews))
+    fields["derived/news/hasQuotaSignal"] = .value(String(hasQuotaSignal))
+}
+
+private enum LegacyReviewMachineStatusProjectionFactory {
+    static func make(
+        _ snapshot: ReviewMachineStatusSnapshot,
+        now: Date,
+        freshness: TimeInterval
+    ) throws -> SnapshotProjection {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        var fields = try CanonicalJSONFieldProjector.flatten(encoder.encode(snapshot))
+        appendDerivedFields(
+            to: &fields,
+            now: now,
+            freshness: freshness,
+            receivedAt: snapshot.receivedAt,
+            thermalState: snapshot.machine.thermalState,
+            temperatureAvailable: snapshot.machine.temperatureAvailable,
+            powerAvailable: snapshot.machine.powerAvailable,
+            queueDepth: snapshot.worker.queueDepth,
+            activeJobCount: snapshot.worker.activeJobCount,
+            workerPhase: snapshot.worker.phase,
+            processRunning: snapshot.codex.processRunning,
+            quotaAvailable: snapshot.codex.quotaAvailable,
+            quotaRemainingPercent: snapshot.codex.quotaRemainingPercent,
+            quotaWindows: snapshot.codex.quotaWindows?.map {
+                ($0.kind, $0.remainingPercent, $0.windowDurationMinutes, $0.resetsAt)
+            },
+            prediction: snapshot.codex.quotaResetPrediction.map {
+                ($0.predictedAt, $0.windowKind, $0.source)
+            },
+            newsStatus: snapshot.news?.status,
+            hasLatestNews: snapshot.news?.latest != nil,
+            hasQuotaSignal: snapshot.news?.latestQuotaSignal != nil
+        )
+        return SnapshotProjection(fields: fields)
+    }
+}
+
+final class ReviewMachineStatusCacheV1Adapter {
+    private let freshness: TimeInterval
+
+    init(freshness: TimeInterval = 5 * 60) {
+        self.freshness = freshness
+    }
+
+    func load(fileURL: URL?, now: Date = Date()) -> Observed<SnapshotProjection> {
+        let source = SourceRef(system: "review-machine-status-cache-v1", locator: fileURL?.path ?? "unavailable")
+        guard let fileURL else {
+            return Observed(value: nil, source: source, observedAt: now, expiresAt: nil, generation: 0, freshness: .unknown, error: ObservationFailure(kind: .unsupported, message: "application support directory unavailable"))
+        }
+        let data: Data
+        do { data = try Data(contentsOf: fileURL) }
+        catch {
+            return Observed(value: nil, source: source, observedAt: now, expiresAt: nil, generation: 0, freshness: .unknown, error: ObservationFailure(kind: .missingEvidence, message: "review machine status cache has not been observed"))
+        }
+        do {
+            let decoder = JSONDecoder()
+            decoder.dateDecodingStrategy = .iso8601
+            let snapshot = try decoder.decode(ReviewMachineStatusCacheV1.self, from: data)
+            let projection = try snapshot.projection(rawData: data, now: now, freshness: freshness)
+            let expiresAt = snapshot.receivedAt.addingTimeInterval(freshness)
+            return Observed(
+                value: projection,
+                source: source,
+                observedAt: snapshot.receivedAt,
+                expiresAt: expiresAt,
+                generation: UInt64(max(0, snapshot.receivedAt.timeIntervalSince1970)),
+                freshness: now >= expiresAt ? .stale : .cached
+            )
+        } catch {
+            return Observed(value: nil, source: source, observedAt: now, expiresAt: nil, generation: 0, freshness: .unreachable, error: ObservationFailure(kind: .invalidData, message: "review machine status cache decode failed"))
+        }
+    }
+}
+
+final class ReviewMachineStatusLegacyFacade {
+    private let legacyStore: ReviewMachineStatusStore
+    private let adapter = ReviewMachineStatusCacheV1Adapter()
+    private let freshness: TimeInterval
+    private(set) var lastReport: ShadowComparisonReport?
+    private(set) var comparisonError: String?
+    var mode: ReviewMachineStatusFacadeMode
+
+    init(
+        legacyStore: ReviewMachineStatusStore,
+        freshness: TimeInterval = 5 * 60,
+        mode: ReviewMachineStatusFacadeMode = .from()
+    ) {
+        self.legacyStore = legacyStore
+        self.freshness = freshness
+        self.mode = mode
+    }
+
+    func load(now: Date = Date()) -> ReviewMachineStatusSnapshot? {
+        let legacy = legacyStore.load()
+        guard mode == .shadow else {
+            lastReport = nil
+            comparisonError = nil
+            return legacy
+        }
+        do {
+            let report = try SnapshotShadowComparator.compare(
+                legacy: try observeLegacy(legacy, now: now),
+                candidate: adapter.load(fileURL: legacyStore.storageURL, now: now),
+                resource: ResourceRef(kind: "review-machine-status-cache", identifier: "review-machine-status.json"),
+                comparedAt: now,
+                allowedDifferences: [
+                    AllowedDifference(fieldPath: "observation.source.system", reason: "legacy and v1 adapters have intentionally distinct source identities")
+                ]
+            )
+            lastReport = report
+            comparisonError = nil
+            let paths = report.differences.map(\.fieldPath).joined(separator: ",")
+            NSLog("OPCB_R01_REVIEW_STATUS_SHADOW differences=%d unexplained=%d fields=%@", report.differences.count, report.unexplainedDifferences.count, paths)
+        } catch {
+            lastReport = nil
+            comparisonError = String(describing: error)
+            NSLog("OPCB_R01_REVIEW_STATUS_SHADOW comparison_error=%@", String(describing: error))
+        }
+        return legacy
+    }
+
+    private func observeLegacy(
+        _ snapshot: ReviewMachineStatusSnapshot?,
+        now: Date
+    ) throws -> Observed<SnapshotProjection> {
+        let source = SourceRef(system: "legacy-review-machine-status-store", locator: legacyStore.storageURL?.path ?? "unavailable")
+        guard let snapshot else {
+            return Observed(value: nil, source: source, observedAt: now, expiresAt: nil, generation: 0, freshness: .unknown, error: ObservationFailure(kind: .missingEvidence, message: "legacy cache returned no status snapshot"))
+        }
+        let expiresAt = snapshot.receivedAt.addingTimeInterval(freshness)
+        return Observed(
+            value: try LegacyReviewMachineStatusProjectionFactory.make(snapshot, now: now, freshness: freshness),
+            source: source,
+            observedAt: snapshot.receivedAt,
+            expiresAt: expiresAt,
+            generation: UInt64(max(0, snapshot.receivedAt.timeIntervalSince1970)),
+            freshness: now >= expiresAt ? .stale : .cached
+        )
+    }
+}
