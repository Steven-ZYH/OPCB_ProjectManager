new file mode 100644
index 0000000000000000000000000000000000000000..406a7bd11b5bfed25baf1f341ad57ed36527f4a7
--- /dev/null
+++ b/tests/NativeReviewMachineStatusFacadeSmoke.swift
@@ -0,0 +1,158 @@
+import Foundation
+
+@main
+private struct NativeReviewMachineStatusFacadeSmoke {
+    static func main() throws {
+        if CommandLine.arguments.count == 2 {
+            try auditFrozenCache(at: URL(fileURLWithPath: CommandLine.arguments[1]))
+            return
+        }
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent(UUID().uuidString, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let fileURL = directory.appendingPathComponent("review-machine-status.json")
+        let receivedAt = Date(timeIntervalSince1970: 1_800_000_000)
+        let snapshot = makeSnapshot(receivedAt: receivedAt)
+        let store = ReviewMachineStatusStore(fileURL: fileURL)
+        store.save(snapshot)
+
+        let legacyOnly = ReviewMachineStatusLegacyFacade(legacyStore: store, mode: .legacyOnly)
+        precondition(legacyOnly.load() == snapshot)
+        precondition(legacyOnly.lastReport == nil)
+
+        let shadow = ReviewMachineStatusLegacyFacade(legacyStore: store, mode: .shadow)
+        precondition(shadow.load(now: receivedAt.addingTimeInterval(299)) == snapshot)
+        let freshReport = try require(shadow.lastReport, "fresh shadow report missing")
+        precondition(freshReport.isEquivalent)
+        precondition(freshReport.differences.count == 1)
+        precondition(freshReport.differences[0].fieldPath == "observation.source.system")
+
+        precondition(shadow.load(now: receivedAt.addingTimeInterval(300)) == snapshot)
+        let staleReport = try require(shadow.lastReport, "stale shadow report missing")
+        precondition(staleReport.isEquivalent)
+        precondition(staleReport.unexplainedDifferences.isEmpty)
+
+        let missingStore = ReviewMachineStatusStore(fileURL: directory.appendingPathComponent("missing.json"))
+        let missingFacade = ReviewMachineStatusLegacyFacade(legacyStore: missingStore, mode: .shadow)
+        precondition(missingFacade.load() == nil)
+        precondition(missingFacade.lastReport?.isEquivalent == true)
+
+        try Data("not-json".utf8).write(to: fileURL)
+        precondition(shadow.load() == nil)
+        let corruptReport = try require(shadow.lastReport, "corrupt report missing")
+        precondition(!corruptReport.isEquivalent)
+        precondition(corruptReport.unexplainedDifferences.contains { $0.fieldPath == "observation.errorKind" })
+
+        store.save(snapshot)
+        var unsupported = try require(JSONSerialization.jsonObject(with: Data(contentsOf: fileURL)) as? [String: Any], "status object missing")
+        unsupported["schema_version"] = 2
+        try JSONSerialization.data(withJSONObject: unsupported).write(to: fileURL)
+        precondition(shadow.load() != nil, "legacy decoder should preserve its existing version behavior")
+        let unsupportedReport = try require(shadow.lastReport, "unsupported version report missing")
+        precondition(!unsupportedReport.isEquivalent)
+        precondition(unsupportedReport.unexplainedDifferences.contains { $0.fieldPath == "observation.freshness" })
+
+        precondition(ReviewMachineStatusFacadeMode.from(environment: [:]) == .legacyOnly)
+        precondition(ReviewMachineStatusFacadeMode.from(environment: ["OPCB_REVIEW_MACHINE_STATUS_FACADE_MODE": "shadow"]) == .shadow)
+        print("NativeReviewMachineStatusFacadeSmoke: PASS")
+    }
+
+    private static func makeSnapshot(receivedAt: Date) -> ReviewMachineStatusSnapshot {
+        let machine = ReviewMachineMetrics(
+            hostname: "review-machine",
+            architecture: "arm64",
+            osVersion: "26.5",
+            cpuPercent: 12.5,
+            loadAverage: [1.0, 0.8, 0.7],
+            memoryUsedBytes: 8_589_934_592,
+            memoryTotalBytes: 17_179_869_184,
+            memoryPercent: 50,
+            diskFreeBytes: 60,
+            diskTotalBytes: 100,
+            diskPercent: 40,
+            uptimeSeconds: 1_000,
+            thermalState: "normal",
+            temperatureCelsius: nil,
+            temperatureAvailable: false,
+            temperatureReason: "permission required",
+            powerWatts: nil,
+            powerAvailable: false,
+            powerReason: "permission required"
+        )
+        let worker = ReviewMachineWorkerMetrics(
+            version: "1.8.0",
+            queueDepth: 0,
+            activeJobCount: 1,
+            phase: "running",
+            jobElapsedSeconds: 12
+        )
+        let windows = [
+            ReviewMachineQuotaWindow(kind: "primary", usedPercent: 25, remainingPercent: 75, windowDurationMinutes: 300, resetsAt: 1_800_003_000),
+            ReviewMachineQuotaWindow(kind: "secondary", usedPercent: 42, remainingPercent: 58, windowDurationMinutes: 10_080, resetsAt: 1_800_604_800),
+        ]
+        let codex = ReviewMachineCodexMetrics(
+            version: "codex-cli 0.146.0",
+            model: "gpt-5.6-sol",
+            reasoningEffort: "high",
+            processRunning: true,
+            processCPUPercent: 25,
+            processMemoryBytes: 104_857_600,
+            threadID: "thread",
+            tokenUsage: nil,
+            quotaRemainingPercent: 58,
+            quotaAvailable: true,
+            quotaReason: "official snapshot",
+            quotaWindows: windows,
+            quotaResetPrediction: ReviewMachineQuotaPrediction(
+                predictedAt: 1_800_604_800,
+                windowKind: "secondary",
+                source: "official_schedule",
+                confidence: "high",
+                reason: "official resetsAt"
+            ),
+            usageDashboardURL: "https://chatgpt.com/codex/settings/usage"
+        )
+        let monitor = ReviewMachineMonitorSnapshot(
+            schemaVersion: 1,
+            sampledAt: "2027-01-15T08:00:00Z",
+            machine: machine,
+            worker: worker,
+            codex: codex,
+            news: nil,
+            job: nil,
+            stream: ReviewMachineLiveStream(
+                jobID: nil,
+                cursor: 0,
+                nextCursor: 0,
+                events: [],
+                truncatedBefore: false
+            )
+        )
+        return ReviewMachineStatusSnapshot(monitor: monitor, receivedAt: receivedAt)
+    }
+
+    private static func auditFrozenCache(at fileURL: URL) throws {
+        let store = ReviewMachineStatusStore(fileURL: fileURL)
+        let facade = ReviewMachineStatusLegacyFacade(legacyStore: store, mode: .shadow)
+        let snapshot = try require(facade.load(), "frozen review machine status missing")
+        let report = try require(facade.lastReport, "frozen review status report missing")
+        guard report.isEquivalent else {
+            throw NSError(domain: "NativeReviewMachineStatusFacadeSmoke", code: 2, userInfo: [NSLocalizedDescriptionKey: "unexplained frozen review status differences: \(report.unexplainedDifferences.count)"])
+        }
+        print(
+            "NativeReviewMachineStatusFacadeFrozenCache: PASS "
+                + "schema=\(snapshot.schemaVersion) "
+                + "active=\(snapshot.worker.activeJobCount > 0 || snapshot.codex.processRunning) "
+                + "differences=\(report.differences.count) "
+                + "unexplained=\(report.unexplainedDifferences.count)"
+        )
+    }
+
+    private static func require<Value>(_ value: Value?, _ message: String) throws -> Value {
+        guard let value else {
+            throw NSError(domain: "NativeReviewMachineStatusFacadeSmoke", code: 1, userInfo: [NSLocalizedDescriptionKey: message])
+        }
+        return value
+    }
+}
