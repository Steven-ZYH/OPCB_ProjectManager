new file mode 100644
index 0000000000000000000000000000000000000000..24c4ac3f90406cd80b3a8379763a1f5cf81b9d55
--- /dev/null
+++ b/tests/ProjectControlDomainTests/ProjectRegistryTests.swift
@@ -0,0 +1,91 @@
+import XCTest
+@testable import ProjectControlDomain
+
+final class ProjectRegistryTests: XCTestCase {
+    private func fixture() -> ProjectRegistryDocument {
+        let source = SourceRef(system: "legacy-config", locator: "native/AppDelegate.swift")
+        let project = ProjectDescriptor(
+            projectID: ProjectID(rawValue: "opcb"),
+            displayName: "OPCB",
+            repository: RepositoryIdentity(provider: "github", owner: "Steven-ZYH", name: "sixlab"),
+            checkouts: [CheckoutRef(path: "/Users/steven/Desktop/目纹/Program/SIXLAB")],
+            defaultBranch: "main",
+            roadmap: ResourceRef(kind: "file", identifier: "docs/ROADMAP.md"),
+            sessionScope: ResourceRef(kind: "codex-session-prefix", identifier: "opcb"),
+            environments: [ResourceRef(kind: "environment", identifier: "production")],
+            providers: [ResourceRef(kind: "provider", identifier: "github")],
+            policyRefs: [ResourceRef(kind: "policy", identifier: "peer-approval/current-head")],
+            capabilities: [CapabilityDescriptor(name: "pull-request-read", mode: "read-only")],
+            fieldProvenance: ["defaultBranch": FieldProvenance(source: source, observedAt: Date(timeIntervalSince1970: 1_786_000_000))]
+        )
+        return ProjectRegistryDocument(projects: [project])
+    }
+
+    func testRoundTripPreservesSemantics() throws {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .secondsSince1970
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .secondsSince1970
+        let data = try ProjectRegistryCodec.encode(fixture(), encoder: encoder)
+        XCTAssertEqual(try ProjectRegistryCodec.decode(data, decoder: decoder), fixture())
+    }
+
+    func testOPCBFixtureCarriesFieldSourcesAndSeparatesCheckoutFromIdentity() throws {
+        let url = try XCTUnwrap(Bundle.module.url(forResource: "opcb-registry-v1", withExtension: "json"))
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .secondsSince1970
+        let document = try ProjectRegistryCodec.decode(Data(contentsOf: url), decoder: decoder)
+        let project = try XCTUnwrap(document.projects.first)
+        XCTAssertEqual(project.projectID.rawValue, "opcb")
+        XCTAssertEqual(project.repository, RepositoryIdentity(provider: "github", owner: "Steven-ZYH", name: "sixlab"))
+        XCTAssertTrue(project.checkouts[0].path.hasPrefix("/"))
+        XCTAssertNotEqual(project.projectID.rawValue, project.checkouts[0].path)
+        XCTAssertEqual(project.fieldProvenance["repository"]?.source.system, "r01-fact-freeze")
+        XCTAssertEqual(project.fieldProvenance["defaultBranch"]?.source.system, "legacy-config")
+    }
+
+    func testRejectsUnknownSchemaAndUnknownFields() throws {
+        let unsupported = Data(#"{"schemaVersion":2,"projects":[]}"#.utf8)
+        XCTAssertThrowsError(try ProjectRegistryCodec.decode(unsupported)) { error in
+            XCTAssertEqual(error as? DomainValidationError, .unsupportedSchemaVersion(2))
+        }
+        let unknown = Data(#"{"schemaVersion":1,"projects":[],"assumeHealthy":true}"#.utf8)
+        XCTAssertThrowsError(try ProjectRegistryCodec.decode(unknown)) { error in
+            XCTAssertEqual(error as? DomainValidationError, .unknownFields(["registry.assumeHealthy"]))
+        }
+
+        let nested = Data(#"{"schemaVersion":1,"projects":[{"projectID":"opcb","displayName":"OPCB","repository":{"provider":"github","owner":"owner","name":"repo","token":"forbidden"},"checkouts":[],"defaultBranch":"main","environments":[],"providers":[],"policyRefs":[],"capabilities":[],"fieldProvenance":{}}]}"#.utf8)
+        XCTAssertThrowsError(try ProjectRegistryCodec.decode(nested)) { error in
+            XCTAssertEqual(error as? DomainValidationError, .unknownFields(["projects[0].repository.token"]))
+        }
+    }
+
+    func testExplicitMigrationCanUpgradeAnOlderSchema() throws {
+        let legacy = Data(#"{"schemaVersion":0,"projects":[]}"#.utf8)
+        let migration = ProjectRegistryCodec.Migration(fromVersion: 0, toVersion: 1) { data in
+            var object = try XCTUnwrap(JSONSerialization.jsonObject(with: data) as? [String: Any])
+            object["schemaVersion"] = 1
+            return try JSONSerialization.data(withJSONObject: object)
+        }
+        let decoded = try ProjectRegistryCodec.decode(legacy, migrations: [migration])
+        XCTAssertEqual(decoded, ProjectRegistryDocument(projects: []))
+    }
+
+    func testProjectIdentityCannotBeAnAbsolutePath() {
+        let bad = ProjectDescriptor(
+            projectID: ProjectID(rawValue: "/tmp/opcb"),
+            displayName: "OPCB",
+            repository: RepositoryIdentity(provider: "github", owner: "owner", name: "repo"),
+            checkouts: [],
+            defaultBranch: "main"
+        )
+        XCTAssertThrowsError(try ProjectRegistryDocument(projects: [bad]).validate())
+    }
+
+    func testDuplicateProjectIDsFailClosed() {
+        let project = fixture().projects[0]
+        XCTAssertThrowsError(try ProjectRegistryDocument(projects: [project, project]).validate()) { error in
+            XCTAssertEqual(error as? DomainValidationError, .duplicate("opcb"))
+        }
+    }
+}
