diff --git a/tests/ProjectControlDomainTests/ObservedTests.swift b/tests/ProjectControlDomainTests/ObservedTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..3f9532de6c608a7eb3a5d19d1ad1db36ad90fb01
--- /dev/null
+++ b/tests/ProjectControlDomainTests/ObservedTests.swift
@@ -0,0 +1,113 @@
+import XCTest
+@testable import ProjectControlDomain
+
+final class ObservedTests: XCTestCase {
+    private let source = SourceRef(system: "github", locator: "pull-request-list")
+
+    private func observed<Value: Codable & Equatable & Sendable>(
+        value: Value?,
+        at: TimeInterval = 100,
+        expires: TimeInterval? = 200,
+        generation: UInt64 = 1,
+        freshness: Freshness = .live,
+        error: ObservationFailure? = nil
+    ) -> Observed<Value> {
+        Observed(
+            value: value,
+            source: source,
+            observedAt: Date(timeIntervalSince1970: at),
+            expiresAt: expires.map(Date.init(timeIntervalSince1970:)),
+            generation: generation,
+            freshness: freshness,
+            error: error
+        )
+    }
+
+    func testTTLTransitionsLiveToStaleWithoutInventingNewEvidence() throws {
+        let live: Observed<[Int]> = observed(value: [1, 2])
+        try live.validate()
+        XCTAssertEqual(live.evaluated(at: Date(timeIntervalSince1970: 199)).freshness, .live)
+        let stale = live.evaluated(at: Date(timeIntervalSince1970: 200))
+        XCTAssertEqual(stale.freshness, .stale)
+        XCTAssertEqual(stale.value, [1, 2])
+        XCTAssertEqual(stale.observedAt, live.observedAt)
+        XCTAssertEqual(stale.generation, live.generation)
+    }
+
+    func testEmptySuccessIsDistinctFromUnknownAndFailure() throws {
+        let empty: Observed<[String]> = observed(value: [])
+        try empty.validate()
+        XCTAssertEqual(empty.value, [])
+        XCTAssertEqual(empty.freshness, .live)
+
+        let unknown: Observed<[String]> = observed(
+            value: nil,
+            expires: nil,
+            freshness: .unknown,
+            error: ObservationFailure(kind: .missingEvidence, message: "not observed")
+        )
+        try unknown.validate()
+        XCTAssertNil(unknown.value)
+
+        let unreachable: Observed<[String]> = observed(
+            value: nil,
+            expires: nil,
+            freshness: .unreachable,
+            error: ObservationFailure(kind: .providerFailure, message: "provider unavailable")
+        )
+        try unreachable.validate()
+        XCTAssertNil(unreachable.value)
+        XCTAssertNotEqual(unreachable.freshness, .live)
+    }
+
+    func testUnreachableCannotMasqueradeAsHealthyOrEmpty() {
+        let invalid: Observed<[String]> = observed(value: [], freshness: .live, error: ObservationFailure(kind: .offline, message: "offline"))
+        XCTAssertThrowsError(try invalid.validate())
+        let missingError: Observed<[String]> = observed(value: nil, expires: nil, freshness: .unreachable)
+        XCTAssertThrowsError(try missingError.validate())
+    }
+
+    func testLateObservationIsDroppedAndRecoveryAccepted() throws {
+        let current: Observed<Int> = observed(value: 2, at: 200, expires: 300, generation: 2)
+        let late: Observed<Int> = observed(value: 1, at: 100, expires: 200, generation: 1)
+        XCTAssertEqual(try ObservationMerger.merge(current: current, candidate: late), .droppedLate)
+
+        let offline: Observed<Int> = observed(
+            value: 2,
+            at: 210,
+            expires: nil,
+            generation: 3,
+            freshness: .unreachable,
+            error: ObservationFailure(kind: .offline, message: "offline")
+        )
+        XCTAssertEqual(try ObservationMerger.merge(current: current, candidate: offline), .accepted(offline))
+
+        let recovered: Observed<Int> = observed(value: 3, at: 220, expires: 320, generation: 4)
+        XCTAssertEqual(try ObservationMerger.merge(current: offline, candidate: recovered), .accepted(recovered))
+    }
+
+    func testTimeoutUnsupportedAndMissingEvidenceStayDistinct() throws {
+        let timeout: Observed<Int> = observed(
+            value: nil,
+            expires: nil,
+            freshness: .unreachable,
+            error: ObservationFailure(kind: .timeout, message: "deadline exceeded")
+        )
+        let unsupported: Observed<Int> = observed(
+            value: nil,
+            expires: nil,
+            freshness: .unknown,
+            error: ObservationFailure(kind: .unsupported, message: "provider lacks capability")
+        )
+        let missing: Observed<Int> = observed(
+            value: nil,
+            expires: nil,
+            freshness: .unknown,
+            error: ObservationFailure(kind: .missingEvidence, message: "not collected")
+        )
+        try [timeout, unsupported, missing].forEach { try $0.validate() }
+        XCTAssertEqual(timeout.error?.kind, .timeout)
+        XCTAssertEqual(unsupported.error?.kind, .unsupported)
+        XCTAssertEqual(missing.error?.kind, .missingEvidence)
+    }
+}
