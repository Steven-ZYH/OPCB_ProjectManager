index 0000000000000000000000000000000000000000..5a13a022c52a90dd60f7f10892b081a73acebb0b
--- /dev/null
+++ b/tests/NativeRoadmapFacadeSmoke.swift
@@ -0,0 +1,104 @@
+import Foundation
+
+@main
+private struct NativeRoadmapFacadeSmoke {
+    static func main() throws {
+        if CommandLine.arguments.count == 2 {
+            try auditFrozenCache(at: URL(fileURLWithPath: CommandLine.arguments[1]))
+            return
+        }
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent(UUID().uuidString, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+
+        let fileURL = directory.appendingPathComponent("roadmaps.json")
+        let snapshot = RoadmapSnapshot(
+            repository: "Steven-ZYH/sixlab",
+            sourceSHA: String(repeating: "a", count: 40),
+            fetchedAt: Date(timeIntervalSince1970: 1_800_000_000),
+            documents: [
+                RoadmapDocument(
+                    id: "docs/roadmap.md",
+                    path: "docs/roadmap.md",
+                    title: "Roadmap",
+                    updatedText: nil,
+                    items: [
+                        RoadmapItem(
+                            id: "task-0",
+                            code: "TODO",
+                            title: "Preserve unknown",
+                            statusText: "待推进",
+                            stage: .unknown,
+                            anchor: nil,
+                            pullRequestNumbers: []
+                        )
+                    ]
+                )
+            ]
+        )
+        let store = RoadmapStore(fileURL: fileURL)
+        store.save(snapshot)
+
+        let legacyOnly = RoadmapLegacyFacade(legacyStore: store, mode: .legacyOnly)
+        precondition(legacyOnly.load() == snapshot)
+        precondition(legacyOnly.lastReport == nil)
+        precondition(legacyOnly.comparisonError == nil)
+
+        let shadow = RoadmapLegacyFacade(legacyStore: store, mode: .shadow)
+        let result = shadow.load(now: Date(timeIntervalSince1970: 1_800_000_100))
+        precondition(result == snapshot, "shadow mode must return the legacy value")
+        let report = try require(shadow.lastReport, "shadow report missing")
+        precondition(shadow.comparisonError == nil)
+        precondition(report.isEquivalent)
+        precondition(report.differences.count == 1)
+        precondition(report.differences[0].fieldPath == "observation.source.system")
+        precondition(report.differences[0].allowedReason != nil)
+        precondition(report.auditEvent.category == .verification)
+        precondition(report.auditEvent.attributes["unexplainedDifferenceCount"] == "0")
+
+        try Data("not-json".utf8).write(to: fileURL)
+        let corruptResult = shadow.load(now: Date(timeIntervalSince1970: 1_800_000_200))
+        precondition(corruptResult == nil, "legacy failure must not be filled as an empty snapshot")
+        let corruptReport = try require(shadow.lastReport, "corrupt shadow report missing")
+        precondition(!corruptReport.isEquivalent)
+        precondition(corruptReport.unexplainedDifferences.contains {
+            $0.fieldPath == "observation.freshness"
+                && $0.legacy == .value(Freshness.unknown.rawValue)
+                && $0.candidate == .value(Freshness.unreachable.rawValue)
+        })
+
+        precondition(LegacyFacadeMode.from(environment: [:]) == .legacyOnly)
+        precondition(LegacyFacadeMode.from(environment: ["OPCB_ROADMAP_FACADE_MODE": "shadow"]) == .shadow)
+        print("NativeRoadmapFacadeSmoke: PASS")
+    }
+
+    private static func auditFrozenCache(at fileURL: URL) throws {
+        let store = RoadmapStore(fileURL: fileURL)
+        let facade = RoadmapLegacyFacade(legacyStore: store, mode: .shadow)
+        let snapshot = try require(facade.load(), "frozen cache did not produce a legacy snapshot")
+        let report = try require(facade.lastReport, "frozen cache shadow report missing")
+        guard report.isEquivalent else {
+            let paths = report.unexplainedDifferences.map(\.fieldPath).joined(separator: ",")
+            throw NSError(
+                domain: "NativeRoadmapFacadeSmoke",
+                code: 2,
+                userInfo: [NSLocalizedDescriptionKey: "unexplained shadow differences: \(paths)"]
+            )
+        }
+        print(
+            "NativeRoadmapFacadeFrozenCache: PASS "
+                + "documents=\(snapshot.documents.count) "
+                + "items=\(snapshot.itemCount) "
+                + "differences=\(report.differences.count) "
+                + "unexplained=\(report.unexplainedDifferences.count)"
+        )
+    }
+
+    private static func require<Value>(_ value: Value?, _ message: String) throws -> Value {
+        guard let value else {
+            throw NSError(domain: "NativeRoadmapFacadeSmoke", code: 1, userInfo: [NSLocalizedDescriptionKey: message])
+        }
+        return value
+    }
+}
