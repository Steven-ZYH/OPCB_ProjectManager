diff --git a/native/RoadmapLegacyFacade.swift b/native/RoadmapLegacyFacade.swift
new file mode 100644
index 0000000000000000000000000000000000000000..609f4d9418a2e38cbf5f3f0474749019d9f43136
--- /dev/null
+++ b/native/RoadmapLegacyFacade.swift
@@ -0,0 +1,226 @@
+import Foundation
+
+enum LegacyFacadeMode: Equatable {
+    case legacyOnly
+    case shadow
+
+    static func from(environment: [String: String] = ProcessInfo.processInfo.environment) -> LegacyFacadeMode {
+        environment["OPCB_ROADMAP_FACADE_MODE"]?.lowercased() == "shadow" ? .shadow : .legacyOnly
+    }
+}
+
+private struct RoadmapCacheV1: Decodable {
+    struct Document: Decodable {
+        struct Item: Decodable {
+            let id: String
+            let code: String
+            let title: String
+            let statusText: String
+            let stage: String
+            let anchor: String?
+            let pullRequestNumbers: [Int]
+        }
+
+        let id: String
+        let path: String
+        let title: String
+        let updatedText: String?
+        let items: [Item]
+    }
+
+    let repository: String
+    let sourceSHA: String?
+    let fetchedAt: Date
+    let documents: [Document]
+
+    var projection: RoadmapProjection {
+        RoadmapProjection(
+            repository: repository,
+            sourceSHA: sourceSHA,
+            fetchedAt: fetchedAt,
+            documents: documents.map { document in
+                RoadmapProjectionDocument(
+                    id: document.id,
+                    path: document.path,
+                    title: document.title,
+                    updatedText: document.updatedText,
+                    items: document.items.map { item in
+                        RoadmapProjectionItem(
+                            id: item.id,
+                            code: item.code,
+                            title: item.title,
+                            statusText: item.statusText,
+                            stage: item.stage,
+                            anchor: item.anchor,
+                            pullRequestNumbers: item.pullRequestNumbers
+                        )
+                    }
+                )
+            }
+        )
+    }
+}
+
+final class RoadmapCacheV1Adapter {
+    private let fileURL: URL?
+    private let ttl: TimeInterval
+
+    init(fileURL: URL?, ttl: TimeInterval = 30 * 60) {
+        self.fileURL = fileURL
+        self.ttl = ttl
+    }
+
+    func load(now: Date = Date()) -> Observed<RoadmapProjection> {
+        let source = SourceRef(system: "roadmap-cache-v1", locator: fileURL?.path ?? "unavailable")
+        guard let fileURL else {
+            return Observed(
+                value: nil,
+                source: source,
+                observedAt: now,
+                expiresAt: nil,
+                generation: 0,
+                freshness: .unknown,
+                error: ObservationFailure(kind: .unsupported, message: "application support directory unavailable")
+            )
+        }
+        let data: Data
+        do {
+            data = try Data(contentsOf: fileURL)
+        } catch {
+            return Observed(
+                value: nil,
+                source: source,
+                observedAt: now,
+                expiresAt: nil,
+                generation: 0,
+                freshness: .unknown,
+                error: ObservationFailure(kind: .missingEvidence, message: "roadmap cache has not been observed")
+            )
+        }
+        do {
+            let decoder = JSONDecoder()
+            decoder.dateDecodingStrategy = .iso8601
+            let value = try decoder.decode(RoadmapCacheV1.self, from: data).projection
+            let expiresAt = value.fetchedAt.addingTimeInterval(ttl)
+            return Observed(
+                value: value,
+                source: source,
+                observedAt: value.fetchedAt,
+                expiresAt: expiresAt,
+                generation: UInt64(max(0, value.fetchedAt.timeIntervalSince1970)),
+                freshness: now >= expiresAt ? .stale : .cached
+            )
+        } catch {
+            return Observed(
+                value: nil,
+                source: source,
+                observedAt: now,
+                expiresAt: nil,
+                generation: 0,
+                freshness: .unreachable,
+                error: ObservationFailure(kind: .invalidData, message: "roadmap cache decode failed")
+            )
+        }
+    }
+}
+
+final class RoadmapLegacyFacade {
+    private let legacyStore: RoadmapStore
+    private let adapter: RoadmapCacheV1Adapter
+    private(set) var lastReport: ShadowComparisonReport?
+    private(set) var comparisonError: String?
+    var mode: LegacyFacadeMode
+
+    init(legacyStore: RoadmapStore, mode: LegacyFacadeMode = .from()) {
+        self.legacyStore = legacyStore
+        self.adapter = RoadmapCacheV1Adapter(fileURL: legacyStore.storageURL)
+        self.mode = mode
+    }
+
+    func load(now: Date = Date()) -> RoadmapSnapshot? {
+        let legacy = legacyStore.load()
+        guard mode == .shadow else {
+            lastReport = nil
+            comparisonError = nil
+            return legacy
+        }
+
+        do {
+            lastReport = try ShadowComparator.compare(
+                legacy: observeLegacy(legacy, now: now),
+                candidate: adapter.load(now: now),
+                resource: ResourceRef(kind: "roadmap-cache", identifier: "roadmaps.json"),
+                comparedAt: now,
+                allowedDifferences: [
+                    AllowedDifference(
+                        fieldPath: "observation.source.system",
+                        reason: "legacy and v1 adapters have intentionally distinct source identities"
+                    )
+                ]
+            )
+            comparisonError = nil
+            if let report = lastReport {
+                let paths = report.differences.map(\.fieldPath).joined(separator: ",")
+                NSLog(
+                    "OPCB_R01_ROADMAP_SHADOW differences=%d unexplained=%d fields=%@",
+                    report.differences.count,
+                    report.unexplainedDifferences.count,
+                    paths
+                )
+            }
+        } catch {
+            lastReport = nil
+            comparisonError = String(describing: error)
+            NSLog("OPCB_R01_ROADMAP_SHADOW comparison_error=%@", String(describing: error))
+        }
+        return legacy
+    }
+
+    private func observeLegacy(_ snapshot: RoadmapSnapshot?, now: Date) -> Observed<RoadmapProjection> {
+        let source = SourceRef(system: "legacy-roadmap-store", locator: legacyStore.storageURL?.path ?? "unavailable")
+        guard let snapshot else {
+            return Observed(
+                value: nil,
+                source: source,
+                observedAt: now,
+                expiresAt: nil,
+                generation: 0,
+                freshness: .unknown,
+                error: ObservationFailure(kind: .missingEvidence, message: "legacy cache returned no snapshot")
+            )
+        }
+        let projection = RoadmapProjection(
+            repository: snapshot.repository,
+            sourceSHA: snapshot.sourceSHA,
+            fetchedAt: snapshot.fetchedAt,
+            documents: snapshot.documents.map { document in
+                RoadmapProjectionDocument(
+                    id: document.id,
+                    path: document.path,
+                    title: document.title,
+                    updatedText: document.updatedText,
+                    items: document.items.map { item in
+                        RoadmapProjectionItem(
+                            id: item.id,
+                            code: item.code,
+                            title: item.title,
+                            statusText: item.statusText,
+                            stage: item.stage.rawValue,
+                            anchor: item.anchor,
+                            pullRequestNumbers: item.pullRequestNumbers
+                        )
+                    }
+                )
+            }
+        )
+        let expiresAt = snapshot.fetchedAt.addingTimeInterval(30 * 60)
+        return Observed(
+            value: projection,
+            source: source,
+            observedAt: snapshot.fetchedAt,
+            expiresAt: expiresAt,
+            generation: UInt64(max(0, snapshot.fetchedAt.timeIntervalSince1970)),
+            freshness: now >= expiresAt ? .stale : .cached
+        )
+    }
+}
