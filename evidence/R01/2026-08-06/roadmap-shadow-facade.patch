+import XCTest
+@testable import ProjectControlDomain
+
+final class ShadowComparisonTests: XCTestCase {
+    private let source = SourceRef(system: "fixture", locator: "roadmaps.json")
+
+    private func projection(title: String = "Roadmap", sourceSHA: String? = nil) -> RoadmapProjection {
+        RoadmapProjection(
+            repository: "Steven-ZYH/sixlab",
+            sourceSHA: sourceSHA,
+            fetchedAt: Date(timeIntervalSince1970: 100),
+            documents: [RoadmapProjectionDocument(id: "docs/roadmap.md", path: "docs/roadmap.md", title: title, updatedText: nil, items: [])]
+        )
+    }
+
+    private func observed(_ projection: RoadmapProjection) -> Observed<RoadmapProjection> {
+        Observed(value: projection, source: source, observedAt: projection.fetchedAt, expiresAt: Date(timeIntervalSince1970: 200), generation: 1, freshness: .cached)
+    }
+
+    func testEquivalentSnapshotsHaveNoDifferences() throws {
+        let value = observed(projection())
+        let report = try ShadowComparator.compare(
+            legacy: value,
+            candidate: value,
+            resource: ResourceRef(kind: "roadmap-cache", identifier: "roadmaps.json"),
+            comparedAt: Date(timeIntervalSince1970: 150)
+        )
+        XCTAssertTrue(report.isEquivalent)
+        XCTAssertTrue(report.differences.isEmpty)
+        XCTAssertEqual(report.auditEvent.category, .verification)
+    }
+
+    func testFieldDifferenceIsUnexplainedUnlessExplicitlyAllowed() throws {
+        let old = observed(projection(title: "Old"))
+        let new = observed(projection(title: "New"))
+        let resource = ResourceRef(kind: "roadmap-cache", identifier: "roadmaps.json")
+        let unexplained = try ShadowComparator.compare(legacy: old, candidate: new, resource: resource, comparedAt: Date(timeIntervalSince1970: 150))
+        XCTAssertEqual(unexplained.unexplainedDifferences.map(\.fieldPath), ["documents[0].title"])
+
+        let allowed = try ShadowComparator.compare(
+            legacy: old,
+            candidate: new,
+            resource: resource,
+            comparedAt: Date(timeIntervalSince1970: 150),
+            allowedDifferences: [AllowedDifference(fieldPath: "documents[0].title", reason: "fixture rename")]
+        )
+        XCTAssertTrue(allowed.isEquivalent)
+        XCTAssertEqual(allowed.differences.first?.allowedReason, "fixture rename")
+    }
+
+    func testMissingSourceSHAStaysMissing() {
+        let missing = projection(sourceSHA: nil).flattened()
+        XCTAssertEqual(missing["sourceSHA"], .missing)
+        XCTAssertNotEqual(missing["sourceSHA"], .value(""))
+    }
+
+    func testDuplicateAllowedDifferenceRulesFailClosed() {
+        let value = observed(projection())
+        XCTAssertThrowsError(
+            try ShadowComparator.compare(
+                legacy: value,
+                candidate: value,
+                resource: ResourceRef(kind: "roadmap-cache", identifier: "roadmaps.json"),
+                comparedAt: Date(timeIntervalSince1970: 150),
+                allowedDifferences: [
+                    AllowedDifference(fieldPath: "repository", reason: "one"),
+                    AllowedDifference(fieldPath: "repository", reason: "two"),
+                ]
+            )
+        ) { error in
+            XCTAssertEqual(error as? DomainValidationError, .duplicate("allowed difference repository"))
+        }
+    }
+}
