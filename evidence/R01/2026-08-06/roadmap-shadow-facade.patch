diff --git a/Sources/ProjectControlDomain/ShadowComparison.swift b/Sources/ProjectControlDomain/ShadowComparison.swift
new file mode 100644
index 0000000000000000000000000000000000000000..7f5c6635a14c68cfcc29b77d9fa48dae1614a612
--- /dev/null
+++ b/Sources/ProjectControlDomain/ShadowComparison.swift
@@ -0,0 +1,186 @@
+import Foundation
+
+public struct RoadmapProjectionItem: Codable, Equatable, Sendable {
+    public let id: String
+    public let code: String
+    public let title: String
+    public let statusText: String
+    public let stage: String
+    public let anchor: String?
+    public let pullRequestNumbers: [Int]
+
+    public init(id: String, code: String, title: String, statusText: String, stage: String, anchor: String?, pullRequestNumbers: [Int]) {
+        self.id = id
+        self.code = code
+        self.title = title
+        self.statusText = statusText
+        self.stage = stage
+        self.anchor = anchor
+        self.pullRequestNumbers = pullRequestNumbers
+    }
+}
+
+public struct RoadmapProjectionDocument: Codable, Equatable, Sendable {
+    public let id: String
+    public let path: String
+    public let title: String
+    public let updatedText: String?
+    public let items: [RoadmapProjectionItem]
+
+    public init(id: String, path: String, title: String, updatedText: String?, items: [RoadmapProjectionItem]) {
+        self.id = id
+        self.path = path
+        self.title = title
+        self.updatedText = updatedText
+        self.items = items
+    }
+}
+
+public struct RoadmapProjection: Codable, Equatable, Sendable {
+    public let repository: String
+    public let sourceSHA: String?
+    public let fetchedAt: Date
+    public let documents: [RoadmapProjectionDocument]
+
+    public init(repository: String, sourceSHA: String?, fetchedAt: Date, documents: [RoadmapProjectionDocument]) {
+        self.repository = repository
+        self.sourceSHA = sourceSHA
+        self.fetchedAt = fetchedAt
+        self.documents = documents
+    }
+
+    public func flattened() -> [String: ShadowFieldValue] {
+        var fields: [String: ShadowFieldValue] = [
+            "repository": .value(repository),
+            "sourceSHA": sourceSHA.map(ShadowFieldValue.value) ?? .missing,
+            "fetchedAt": .value(String(fetchedAt.timeIntervalSince1970)),
+            "documents.count": .value(String(documents.count)),
+        ]
+        for (documentIndex, document) in documents.enumerated() {
+            let prefix = "documents[\(documentIndex)]"
+            fields["\(prefix).id"] = .value(document.id)
+            fields["\(prefix).path"] = .value(document.path)
+            fields["\(prefix).title"] = .value(document.title)
+            fields["\(prefix).updatedText"] = document.updatedText.map(ShadowFieldValue.value) ?? .missing
+            fields["\(prefix).items.count"] = .value(String(document.items.count))
+            for (itemIndex, item) in document.items.enumerated() {
+                let itemPrefix = "\(prefix).items[\(itemIndex)]"
+                fields["\(itemPrefix).id"] = .value(item.id)
+                fields["\(itemPrefix).code"] = .value(item.code)
+                fields["\(itemPrefix).title"] = .value(item.title)
+                fields["\(itemPrefix).statusText"] = .value(item.statusText)
+                fields["\(itemPrefix).stage"] = .value(item.stage)
+                fields["\(itemPrefix).anchor"] = item.anchor.map(ShadowFieldValue.value) ?? .missing
+                fields["\(itemPrefix).pullRequestNumbers"] = .value(item.pullRequestNumbers.map(String.init).joined(separator: ","))
+            }
+        }
+        return fields
+    }
+}
+
+public enum ShadowFieldValue: Codable, Equatable, Sendable, CustomStringConvertible {
+    case value(String)
+    case missing
+
+    public var description: String {
+        switch self {
+        case .value(let value): return value
+        case .missing: return "<missing>"
+        }
+    }
+}
+
+public struct AllowedDifference: Codable, Equatable, Sendable {
+    public let fieldPath: String
+    public let reason: String
+
+    public init(fieldPath: String, reason: String) {
+        self.fieldPath = fieldPath
+        self.reason = reason
+    }
+}
+
+public struct ShadowDifference: Codable, Equatable, Sendable {
+    public let fieldPath: String
+    public let legacy: ShadowFieldValue
+    public let candidate: ShadowFieldValue
+    public let allowedReason: String?
+
+    public init(fieldPath: String, legacy: ShadowFieldValue, candidate: ShadowFieldValue, allowedReason: String?) {
+        self.fieldPath = fieldPath
+        self.legacy = legacy
+        self.candidate = candidate
+        self.allowedReason = allowedReason
+    }
+}
+
+public struct ShadowComparisonReport: Codable, Equatable, Sendable {
+    public let resource: ResourceRef
+    public let comparedAt: Date
+    public let differences: [ShadowDifference]
+    public let auditEvent: AuditEvent
+
+    public var unexplainedDifferences: [ShadowDifference] {
+        differences.filter { $0.allowedReason == nil }
+    }
+
+    public var isEquivalent: Bool { unexplainedDifferences.isEmpty }
+}
+
+public enum ShadowComparator {
+    public static func compare(
+        legacy: Observed<RoadmapProjection>,
+        candidate: Observed<RoadmapProjection>,
+        resource: ResourceRef,
+        comparedAt: Date,
+        allowedDifferences: [AllowedDifference] = []
+    ) throws -> ShadowComparisonReport {
+        try legacy.validate()
+        try candidate.validate()
+        var allowed: [String: String] = [:]
+        for difference in allowedDifferences {
+            guard allowed.updateValue(difference.reason, forKey: difference.fieldPath) == nil else {
+                throw DomainValidationError.duplicate("allowed difference \(difference.fieldPath)")
+            }
+        }
+        var legacyFields = legacy.value?.flattened() ?? [:]
+        var candidateFields = candidate.value?.flattened() ?? [:]
+        legacyFields["observation.source.system"] = .value(legacy.source.system)
+        candidateFields["observation.source.system"] = .value(candidate.source.system)
+        legacyFields["observation.source.locator"] = .value(legacy.source.locator)
+        candidateFields["observation.source.locator"] = .value(candidate.source.locator)
+        legacyFields["observation.observedAt"] = .value(String(legacy.observedAt.timeIntervalSince1970))
+        candidateFields["observation.observedAt"] = .value(String(candidate.observedAt.timeIntervalSince1970))
+        legacyFields["observation.expiresAt"] = legacy.expiresAt.map { .value(String($0.timeIntervalSince1970)) } ?? .missing
+        candidateFields["observation.expiresAt"] = candidate.expiresAt.map { .value(String($0.timeIntervalSince1970)) } ?? .missing
+        legacyFields["observation.generation"] = .value(String(legacy.generation))
+        candidateFields["observation.generation"] = .value(String(candidate.generation))
+        legacyFields["observation.freshness"] = .value(legacy.freshness.rawValue)
+        candidateFields["observation.freshness"] = .value(candidate.freshness.rawValue)
+        legacyFields["observation.errorKind"] = legacy.error.map { .value($0.kind.rawValue) } ?? .missing
+        candidateFields["observation.errorKind"] = candidate.error.map { .value($0.kind.rawValue) } ?? .missing
+
+        let keys = Set(legacyFields.keys).union(candidateFields.keys).sorted()
+        let differences = keys.compactMap { key -> ShadowDifference? in
+            let old = legacyFields[key] ?? .missing
+            let new = candidateFields[key] ?? .missing
+            guard old != new else { return nil }
+            return ShadowDifference(fieldPath: key, legacy: old, candidate: new, allowedReason: allowed[key])
+        }
+        let event = AuditEvent(
+            eventID: UUID(),
+            projectID: ProjectID(rawValue: "opcb"),
+            resource: resource,
+            category: .verification,
+            source: SourceRef(system: "legacy-facade", locator: "roadmap-cache-shadow-v1"),
+            observedAt: comparedAt,
+            generation: max(legacy.generation, candidate.generation),
+            attributes: [
+                "differenceCount": String(differences.count),
+                "unexplainedDifferenceCount": String(differences.filter { $0.allowedReason == nil }.count),
+            ]
+        )
+        try event.validate()
+        return ShadowComparisonReport(resource: resource, comparedAt: comparedAt, differences: differences, auditEvent: event)
+    }
+}
