diff --git a/tests/NativeSnapshotFacadeSmoke.swift b/tests/NativeSnapshotFacadeSmoke.swift
new file mode 100644
index 0000000000000000000000000000000000000000..3c79fb71ba0d5b6b5a6e484d352833516c3b70b6
--- /dev/null
+++ b/tests/NativeSnapshotFacadeSmoke.swift
@@ -0,0 +1,134 @@
+import Foundation
+
+@main
+private struct NativeSnapshotFacadeSmoke {
+    static func main() throws {
+        if CommandLine.arguments.count == 2 {
+            try auditFrozenCaches(in: URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true))
+            return
+        }
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent(UUID().uuidString, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+
+        let decoder = JSONDecoder()
+        let pullRequest = try decoder.decode(PullRequest.self, from: Data(#"""
+        {
+          "number": 42,
+          "title": "Preserve current-head truth",
+          "url": "https://github.com/owner/repo/pull/42",
+          "reviewDecision": "APPROVED",
+          "isDraft": false,
+          "statusCheckRollup": [
+            {"name":"peer-approval/current-head","status":"COMPLETED","conclusion":"SUCCESS","startedAt":"2026-08-06T00:00:00Z"},
+            {"name":"ci","status":"COMPLETED","conclusion":"SUCCESS","startedAt":"2026-08-06T00:00:01Z"}
+          ],
+          "mergeable": "MERGEABLE",
+          "updatedAt": "2026-08-06T00:00:02Z",
+          "author": {"login":"author"},
+          "reviewRequests": [],
+          "headRefName": "feature",
+          "headRefOid": "head-sha",
+          "currentHeadReviewDecision": "APPROVED"
+        }
+        """#.utf8))
+        let snapshot = DashboardSnapshot(
+            repository: "owner/repo",
+            currentUser: "reviewer",
+            fetchedAt: Date(timeIntervalSince1970: 1_800_000_000),
+            pullRequests: [pullRequest],
+            deployments: [],
+            telemetryComplete: true
+        )
+        let store = SnapshotStore(directoryURL: directory)
+        store.save(snapshot)
+
+        let legacyOnly = SnapshotLegacyFacade(legacyStore: store, mode: .legacyOnly)
+        precondition(legacyOnly.load(repository: "owner/repo")?.menuBadgeCount == snapshot.menuBadgeCount)
+        precondition(legacyOnly.lastReports.isEmpty)
+
+        let shadow = SnapshotLegacyFacade(legacyStore: store, mode: .shadow)
+        let loaded = shadow.load(repository: "owner/repo", now: Date(timeIntervalSince1970: 1_800_000_100))
+        precondition(loaded?.pullRequests.map(\.number) == [42])
+        let report = try require(shadow.lastReports["owner/repo"], "shadow report missing")
+        precondition(report.isEquivalent)
+        precondition(report.differences.count == 1)
+        precondition(report.differences[0].fieldPath == "observation.source.system")
+        precondition(report.unexplainedDifferences.isEmpty)
+
+        precondition(shadow.load(repository: "missing/repo") == nil)
+        let missingReport = try require(shadow.lastReports["missing/repo"], "missing-evidence report missing")
+        precondition(missingReport.isEquivalent)
+        precondition(missingReport.unexplainedDifferences.isEmpty)
+
+        let wrongURL = try require(store.storageURL(for: "other/repo"), "other repo URL missing")
+        let validData = try Data(contentsOf: try require(store.storageURL(for: "owner/repo"), "owner repo URL missing"))
+        try validData.write(to: wrongURL)
+        precondition(shadow.load(repository: "other/repo") == nil)
+        let wrongReport = try require(shadow.lastReports["other/repo"], "wrong repo report missing")
+        precondition(!wrongReport.isEquivalent)
+        precondition(wrongReport.unexplainedDifferences.contains { $0.fieldPath == "observation.freshness" })
+
+        try Data("not-json".utf8).write(to: try require(store.storageURL(for: "owner/repo"), "owner repo URL missing"))
+        precondition(shadow.load(repository: "owner/repo") == nil)
+        let corruptReport = try require(shadow.lastReports["owner/repo"], "corrupt report missing")
+        precondition(!corruptReport.isEquivalent)
+        precondition(corruptReport.unexplainedDifferences.contains { $0.fieldPath == "observation.errorKind" })
+
+        let fallbackDirectory = directory.appendingPathComponent("legacy-fallback", isDirectory: true)
+        try FileManager.default.createDirectory(at: fallbackDirectory, withIntermediateDirectories: true)
+        let fallbackSnapshot = DashboardSnapshot(
+            repository: PRProject.opcb.repository,
+            currentUser: "reviewer",
+            fetchedAt: snapshot.fetchedAt,
+            pullRequests: [pullRequest],
+            deployments: [],
+            telemetryComplete: true
+        )
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        try encoder.encode(fallbackSnapshot).write(to: fallbackDirectory.appendingPathComponent("snapshot.json"))
+        let fallbackStore = SnapshotStore(directoryURL: fallbackDirectory)
+        let fallbackFacade = SnapshotLegacyFacade(legacyStore: fallbackStore, mode: .shadow)
+        precondition(fallbackFacade.load(repository: PRProject.opcb.repository)?.repository == PRProject.opcb.repository)
+        let fallbackReport = try require(fallbackFacade.lastReports[PRProject.opcb.id], "legacy fallback report missing")
+        precondition(fallbackReport.isEquivalent)
+        precondition(fallbackReport.unexplainedDifferences.isEmpty)
+
+        precondition(SnapshotLegacyFacadeMode.from(environment: [:]) == .legacyOnly)
+        precondition(SnapshotLegacyFacadeMode.from(environment: ["OPCB_PR_OVERVIEW_FACADE_MODE": "shadow"]) == .shadow)
+        print("NativeSnapshotFacadeSmoke: PASS")
+    }
+
+    private static func auditFrozenCaches(in directory: URL) throws {
+        let store = SnapshotStore(directoryURL: directory)
+        let facade = SnapshotLegacyFacade(legacyStore: store, mode: .shadow)
+        let repositories = [
+            PRProject.opcb.repository,
+            PRProject.prControl.repository,
+            PRProject.opcbFDE.repository,
+        ]
+        var pullRequests = 0
+        var differences = 0
+        var unexplained = 0
+        for repository in repositories {
+            let snapshot = try require(facade.load(repository: repository), "missing frozen snapshot for \(repository)")
+            let report = try require(facade.lastReports[repository.lowercased()], "missing frozen report for \(repository)")
+            pullRequests += snapshot.pullRequests.count
+            differences += report.differences.count
+            unexplained += report.unexplainedDifferences.count
+        }
+        guard unexplained == 0 else {
+            throw NSError(domain: "NativeSnapshotFacadeSmoke", code: 2, userInfo: [NSLocalizedDescriptionKey: "unexplained frozen snapshot differences: \(unexplained)"])
+        }
+        print("NativeSnapshotFacadeFrozenCaches: PASS projects=\(repositories.count) pullRequests=\(pullRequests) differences=\(differences) unexplained=\(unexplained)")
+    }
+
+    private static func require<Value>(_ value: Value?, _ message: String) throws -> Value {
+        guard let value else {
+            throw NSError(domain: "NativeSnapshotFacadeSmoke", code: 1, userInfo: [NSLocalizedDescriptionKey: message])
+        }
+        return value
+    }
+}
