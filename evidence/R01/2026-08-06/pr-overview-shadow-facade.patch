diff --git a/native/SnapshotLegacyFacade.swift b/native/SnapshotLegacyFacade.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e6d851a976bfee21a2439755d30d49aea94d6334
--- /dev/null
+++ b/native/SnapshotLegacyFacade.swift
@@ -0,0 +1,345 @@
+import Foundation
+
+enum SnapshotLegacyFacadeMode: Equatable {
+    case legacyOnly
+    case shadow
+
+    static func from(environment: [String: String] = ProcessInfo.processInfo.environment) -> SnapshotLegacyFacadeMode {
+        environment["OPCB_PR_OVERVIEW_FACADE_MODE"]?.lowercased() == "shadow" ? .shadow : .legacyOnly
+    }
+}
+
+private struct SnapshotCacheV1: Decodable {
+    struct Identity: Decodable {
+        let login: String?
+        let slug: String?
+        let name: String?
+
+        var displayName: String { login ?? slug ?? name ?? "unknown" }
+    }
+
+    struct Check: Decodable {
+        let name: String?
+        let context: String?
+        let status: String?
+        let conclusion: String?
+        let state: String?
+        let startedAt: String?
+        let completedAt: String?
+
+        var displayName: String { name ?? context ?? "unknown" }
+        var isReviewGate: Bool { displayName.lowercased().contains("peer-approval") }
+        var sortTimestamp: String { startedAt ?? completedAt ?? "" }
+        var normalizedConclusion: String { (conclusion ?? state ?? "").uppercased() }
+        var normalizedStatus: String { (status ?? "").uppercased() }
+        var isFailure: Bool {
+            ["FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"]
+                .contains(normalizedConclusion)
+        }
+        var isPending: Bool {
+            ["QUEUED", "IN_PROGRESS", "PENDING"].contains(normalizedStatus)
+                || ["PENDING", "EXPECTED"].contains(normalizedConclusion)
+        }
+        var isSkipped: Bool { ["SKIPPED", "NEUTRAL"].contains(normalizedConclusion) }
+        var isPassed: Bool { normalizedConclusion == "SUCCESS" }
+    }
+
+    struct PullRequest: Decodable {
+        let number: Int
+        let reviewDecision: String?
+        let isDraft: Bool
+        let statusCheckRollup: [Check]?
+        let mergeable: String?
+        let reviewRequests: [Identity]?
+        let headRefOid: String?
+        let currentHeadReviewDecision: String?
+
+        var latestPeerApprovalCheck: Check? {
+            (statusCheckRollup ?? []).filter(\.isReviewGate)
+                .max { $0.sortTimestamp < $1.sortTimestamp }
+        }
+        var ciChecks: [Check] {
+            let all = statusCheckRollup ?? []
+            return all.filter { !$0.isReviewGate } + (latestPeerApprovalCheck.map { [$0] } ?? [])
+                .filter { !$0.isReviewGate }
+        }
+        var normalizedReviewDecision: String {
+            if let currentHeadReviewDecision {
+                return currentHeadReviewDecision == "PENDING_CURRENT_HEAD" ? "" : currentHeadReviewDecision.uppercased()
+            }
+            return (reviewDecision ?? "").uppercased()
+        }
+        var peerApprovalSatisfied: Bool {
+            latestPeerApprovalCheck?.isPassed ?? (normalizedReviewDecision == "APPROVED")
+        }
+        var hasCurrentHeadApproval: Bool {
+            if let currentHeadReviewDecision {
+                return currentHeadReviewDecision.uppercased() == "APPROVED"
+            }
+            return headRefOid == nil && (reviewDecision ?? "").uppercased() == "APPROVED"
+        }
+        var reviewGateSyncPending: Bool {
+            guard hasCurrentHeadApproval, let latestPeerApprovalCheck else { return false }
+            return !latestPeerApprovalCheck.isPassed
+        }
+        var hasFailure: Bool { ciChecks.contains(where: \.isFailure) }
+        var hasPending: Bool { ciChecks.contains(where: \.isPending) }
+        var allChecksPassed: Bool { !ciChecks.isEmpty && !hasFailure && !hasPending }
+        var isAwaitingPeerApproval: Bool {
+            !isDraft
+                && normalizedReviewDecision != "CHANGES_REQUESTED"
+                && !hasCurrentHeadApproval
+                && !peerApprovalSatisfied
+        }
+        var group: String {
+            if isDraft { return "draft" }
+            if mergeable?.uppercased() == "CONFLICTING" || hasFailure
+                || normalizedReviewDecision == "CHANGES_REQUESTED" { return "action" }
+            if normalizedReviewDecision == "APPROVED" && peerApprovalSatisfied && allChecksPassed { return "ready" }
+            if isAwaitingPeerApproval && !hasPending { return "review" }
+            return "running"
+        }
+        func requiresReview(from login: String) -> Bool {
+            reviewRequests?.contains { $0.displayName.caseInsensitiveCompare(login) == .orderedSame } ?? false
+        }
+        var checkCounts: (passed: Int, running: Int, failed: Int, skipped: Int) {
+            ciChecks.reduce(into: (0, 0, 0, 0)) { result, check in
+                if check.isFailure { result.2 += 1 }
+                else if check.isPending { result.1 += 1 }
+                else if check.isSkipped { result.3 += 1 }
+                else if check.isPassed { result.0 += 1 }
+            }
+        }
+        var telemetrySummary: String {
+            let counts = checkCounts
+            var parts: [String] = []
+            if counts.passed > 0 { parts.append("✓\(counts.passed)") }
+            if counts.running > 0 { parts.append("●\(counts.running)") }
+            if counts.failed > 0 { parts.append("✕\(counts.failed)") }
+            if counts.skipped > 0 { parts.append("⊘\(counts.skipped)") }
+            return parts.joined(separator: "  ")
+        }
+        var fallbackActionInsight: ActionInsight? {
+            if mergeable?.uppercased() == "CONFLICTING" {
+                return ActionInsight(reason: "当前分支与 main 存在合并冲突", nextStep: "同步 main → 解决冲突 → push 新 head")
+            }
+            if let failed = ciChecks.first(where: \.isFailure) {
+                return ActionInsight(reason: "\(failed.displayName) 检查失败", nextStep: "打开详情读取失败步骤 → 修复 → push")
+            }
+            if normalizedReviewDecision == "CHANGES_REQUESTED" {
+                return ActionInsight(reason: "评审者已提出修改要求", nextStep: "处理评审意见 → push 新 head → 重新请求审核")
+            }
+            return nil
+        }
+    }
+
+    struct ActionInsight: Decodable {
+        let reason: String
+        let nextStep: String
+    }
+
+    struct Deployment: Decodable {
+        struct Run: Decodable {
+            let conclusion: String?
+            var isFailure: Bool {
+                ["failure", "cancelled", "timed_out", "startup_failure"]
+                    .contains((conclusion ?? "").lowercased())
+            }
+        }
+
+        let automatic: Bool
+        let run: Run?
+    }
+
+    let repository: String
+    let currentUser: String
+    let fetchedAt: Date
+    let pullRequests: [PullRequest]
+    let deployments: [Deployment]
+    let telemetryComplete: Bool
+    let actionInsights: [Int: ActionInsight]?
+
+    func projection(rawData: Data) throws -> SnapshotProjection {
+        var fields = try CanonicalJSONFieldProjector.flatten(rawData)
+        var seen = Set<Int>()
+        for pullRequest in pullRequests {
+            guard seen.insert(pullRequest.number).inserted else {
+                throw DomainValidationError.duplicate("pull request \(pullRequest.number)")
+            }
+            let prefix = "derived/pullRequests/\(pullRequest.number)"
+            let counts = pullRequest.checkCounts
+            fields["\(prefix)/group"] = .value(pullRequest.group)
+            fields["\(prefix)/checks/passed"] = .value(String(counts.passed))
+            fields["\(prefix)/checks/running"] = .value(String(counts.running))
+            fields["\(prefix)/checks/failed"] = .value(String(counts.failed))
+            fields["\(prefix)/checks/skipped"] = .value(String(counts.skipped))
+            fields["\(prefix)/peerApprovalSatisfied"] = .value(String(pullRequest.peerApprovalSatisfied))
+            fields["\(prefix)/hasCurrentHeadApproval"] = .value(String(pullRequest.hasCurrentHeadApproval))
+            fields["\(prefix)/isAwaitingPeerApproval"] = .value(String(pullRequest.isAwaitingPeerApproval))
+            fields["\(prefix)/reviewGateSyncPending"] = .value(String(pullRequest.reviewGateSyncPending))
+            fields["\(prefix)/requiresCurrentUserReview"] = .value(String(pullRequest.requiresReview(from: currentUser)))
+            fields["\(prefix)/normalizedReviewDecision"] = .value(pullRequest.normalizedReviewDecision)
+            fields["\(prefix)/telemetrySummary"] = .value(pullRequest.telemetrySummary)
+            let insight = actionInsights?[pullRequest.number] ?? pullRequest.fallbackActionInsight
+            fields["\(prefix)/effectiveActionReason"] = insight.map { .value($0.reason) } ?? .missing
+            fields["\(prefix)/effectiveActionNextStep"] = insight.map { .value($0.nextStep) } ?? .missing
+        }
+        let groups = Dictionary(grouping: pullRequests, by: \.group).mapValues(\.count)
+        for group in ["action", "ready", "review", "running", "draft"] {
+            fields["derived/groups/\(group)"] = .value(String(groups[group] ?? 0))
+        }
+        let reviewCount = pullRequests.filter { $0.group == "review" || $0.requiresReview(from: currentUser) }.count
+        let deploymentFailures = deployments.filter { $0.automatic && $0.run?.isFailure == true }.count
+        let menuBadgeCount: Int
+        if deploymentFailures > 0 { menuBadgeCount = deploymentFailures }
+        else if reviewCount > 0 { menuBadgeCount = reviewCount }
+        else if (groups["action"] ?? 0) > 0 { menuBadgeCount = groups["action"] ?? 0 }
+        else if (groups["ready"] ?? 0) > 0 { menuBadgeCount = groups["ready"] ?? 0 }
+        else { menuBadgeCount = pullRequests.count }
+        fields["derived/pullRequests/count"] = .value(String(pullRequests.count))
+        fields["derived/reviewCount"] = .value(String(reviewCount))
+        fields["derived/automaticDeployFailureCount"] = .value(String(deploymentFailures))
+        fields["derived/menuBadgeCount"] = .value(String(menuBadgeCount))
+        return SnapshotProjection(fields: fields)
+    }
+}
+
+private enum LegacySnapshotProjectionFactory {
+    static func make(_ snapshot: DashboardSnapshot) throws -> SnapshotProjection {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        var fields = try CanonicalJSONFieldProjector.flatten(encoder.encode(snapshot))
+        for pullRequest in snapshot.pullRequests {
+            let prefix = "derived/pullRequests/\(pullRequest.number)"
+            let counts = pullRequest.checkCounts
+            fields["\(prefix)/group"] = .value(pullRequest.group.rawValue)
+            fields["\(prefix)/checks/passed"] = .value(String(counts.passed))
+            fields["\(prefix)/checks/running"] = .value(String(counts.running))
+            fields["\(prefix)/checks/failed"] = .value(String(counts.failed))
+            fields["\(prefix)/checks/skipped"] = .value(String(counts.skipped))
+            fields["\(prefix)/peerApprovalSatisfied"] = .value(String(pullRequest.peerApprovalSatisfied))
+            fields["\(prefix)/hasCurrentHeadApproval"] = .value(String(pullRequest.hasCurrentHeadApproval))
+            fields["\(prefix)/isAwaitingPeerApproval"] = .value(String(pullRequest.isAwaitingPeerApproval))
+            fields["\(prefix)/reviewGateSyncPending"] = .value(String(pullRequest.reviewGateSyncPending))
+            fields["\(prefix)/requiresCurrentUserReview"] = .value(String(pullRequest.requiresReview(from: snapshot.currentUser)))
+            fields["\(prefix)/normalizedReviewDecision"] = .value(pullRequest.normalizedReviewDecision)
+            fields["\(prefix)/telemetrySummary"] = .value(pullRequest.telemetrySummary)
+            let insight = snapshot.actionInsight(for: pullRequest) ?? pullRequest.fallbackActionInsight
+            fields["\(prefix)/effectiveActionReason"] = insight.map { .value($0.reason) } ?? .missing
+            fields["\(prefix)/effectiveActionNextStep"] = insight.map { .value($0.nextStep) } ?? .missing
+        }
+        for group in PRGroup.allCases {
+            fields["derived/groups/\(group.rawValue)"] = .value(String(snapshot.count(in: group)))
+        }
+        fields["derived/pullRequests/count"] = .value(String(snapshot.pullRequests.count))
+        fields["derived/reviewCount"] = .value(String(snapshot.reviewCount))
+        fields["derived/automaticDeployFailureCount"] = .value(String(snapshot.automaticDeployFailureCount))
+        fields["derived/menuBadgeCount"] = .value(String(snapshot.menuBadgeCount))
+        return SnapshotProjection(fields: fields)
+    }
+}
+
+final class SnapshotCacheV1Adapter {
+    private let ttl: TimeInterval
+
+    init(ttl: TimeInterval = 120) {
+        self.ttl = ttl
+    }
+
+    func load(repository: String, fileURL: URL?, now: Date = Date()) -> Observed<SnapshotProjection> {
+        let source = SourceRef(system: "pr-overview-cache-v1", locator: fileURL?.path ?? "unavailable")
+        guard let fileURL else {
+            return Observed(value: nil, source: source, observedAt: now, expiresAt: nil, generation: 0, freshness: .unknown, error: ObservationFailure(kind: .unsupported, message: "application support directory unavailable"))
+        }
+        let data: Data
+        do { data = try Data(contentsOf: fileURL) }
+        catch {
+            return Observed(value: nil, source: source, observedAt: now, expiresAt: nil, generation: 0, freshness: .unknown, error: ObservationFailure(kind: .missingEvidence, message: "PR overview cache has not been observed"))
+        }
+        do {
+            let decoder = JSONDecoder()
+            decoder.dateDecodingStrategy = .iso8601
+            let snapshot = try decoder.decode(SnapshotCacheV1.self, from: data)
+            guard snapshot.repository.caseInsensitiveCompare(repository) == .orderedSame else {
+                throw DomainValidationError.invalidState("snapshot repository does not match requested project")
+            }
+            let projection = try snapshot.projection(rawData: data)
+            let expiresAt = snapshot.fetchedAt.addingTimeInterval(ttl)
+            return Observed(
+                value: projection,
+                source: source,
+                observedAt: snapshot.fetchedAt,
+                expiresAt: expiresAt,
+                generation: UInt64(max(0, snapshot.fetchedAt.timeIntervalSince1970)),
+                freshness: now >= expiresAt ? .stale : .cached
+            )
+        } catch {
+            return Observed(value: nil, source: source, observedAt: now, expiresAt: nil, generation: 0, freshness: .unreachable, error: ObservationFailure(kind: .invalidData, message: "PR overview cache decode failed"))
+        }
+    }
+}
+
+final class SnapshotLegacyFacade {
+    private let legacyStore: SnapshotStore
+    private let adapter = SnapshotCacheV1Adapter()
+    private(set) var lastReports: [String: ShadowComparisonReport] = [:]
+    private(set) var comparisonErrors: [String: String] = [:]
+    var mode: SnapshotLegacyFacadeMode
+
+    init(legacyStore: SnapshotStore, mode: SnapshotLegacyFacadeMode = .from()) {
+        self.legacyStore = legacyStore
+        self.mode = mode
+    }
+
+    func load(repository: String, now: Date = Date()) -> DashboardSnapshot? {
+        let legacy = legacyStore.load(repository: repository)
+        guard mode == .shadow else {
+            lastReports.removeValue(forKey: repository.lowercased())
+            comparisonErrors.removeValue(forKey: repository.lowercased())
+            return legacy
+        }
+        let key = repository.lowercased()
+        let fileURL = legacyStore.resolvedStorageURL(for: repository)
+        do {
+            let report = try SnapshotShadowComparator.compare(
+                legacy: try observeLegacy(legacy, repository: repository, fileURL: fileURL, now: now),
+                candidate: adapter.load(repository: repository, fileURL: fileURL, now: now),
+                resource: ResourceRef(kind: "pr-overview-cache", identifier: repository),
+                comparedAt: now,
+                allowedDifferences: [
+                    AllowedDifference(fieldPath: "observation.source.system", reason: "legacy and v1 adapters have intentionally distinct source identities")
+                ]
+            )
+            lastReports[key] = report
+            comparisonErrors.removeValue(forKey: key)
+            let paths = report.differences.map(\.fieldPath).joined(separator: ",")
+            NSLog("OPCB_R01_PR_SHADOW repository=%@ differences=%d unexplained=%d fields=%@", repository, report.differences.count, report.unexplainedDifferences.count, paths)
+        } catch {
+            lastReports.removeValue(forKey: key)
+            comparisonErrors[key] = String(describing: error)
+            NSLog("OPCB_R01_PR_SHADOW repository=%@ comparison_error=%@", repository, String(describing: error))
+        }
+        return legacy
+    }
+
+    private func observeLegacy(
+        _ snapshot: DashboardSnapshot?,
+        repository: String,
+        fileURL: URL?,
+        now: Date
+    ) throws -> Observed<SnapshotProjection> {
+        let source = SourceRef(system: "legacy-snapshot-store", locator: fileURL?.path ?? "unavailable")
+        guard let snapshot else {
+            return Observed(value: nil, source: source, observedAt: now, expiresAt: nil, generation: 0, freshness: .unknown, error: ObservationFailure(kind: .missingEvidence, message: "legacy cache returned no snapshot"))
+        }
+        let expiresAt = snapshot.fetchedAt.addingTimeInterval(120)
+        return Observed(
+            value: try LegacySnapshotProjectionFactory.make(snapshot),
+            source: source,
+            observedAt: snapshot.fetchedAt,
+            expiresAt: expiresAt,
+            generation: UInt64(max(0, snapshot.fetchedAt.timeIntervalSince1970)),
+            freshness: now >= expiresAt ? .stale : .cached
+        )
+    }
+}
