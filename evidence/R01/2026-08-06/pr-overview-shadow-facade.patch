new file mode 100644
index 0000000000000000000000000000000000000000..34f1416ac615f44de44a0901b9705bfdf1a24387
--- /dev/null
+++ b/tests/ProjectControlDomainTests/SnapshotShadowComparisonTests.swift
@@ -0,0 +1,57 @@
+import XCTest
+@testable import ProjectControlDomain
+
+final class SnapshotShadowComparisonTests: XCTestCase {
+    private let source = SourceRef(system: "fixture", locator: "snapshot.json")
+
+    private func observed(_ fields: [String: ShadowFieldValue]) -> Observed<SnapshotProjection> {
+        Observed(
+            value: SnapshotProjection(fields: fields),
+            source: source,
+            observedAt: Date(timeIntervalSince1970: 100),
+            expiresAt: Date(timeIntervalSince1970: 200),
+            generation: 1,
+            freshness: .cached
+        )
+    }
+
+    func testCanonicalFieldsDistinguishMissingNullAndScalarTypes() throws {
+        let data = Data(#"{"missingSibling":null,"string":"true","boolean":true,"number":1,"empty":[]}"#.utf8)
+        let fields = try CanonicalJSONFieldProjector.flatten(data)
+        XCTAssertEqual(fields["json/missingSibling"], .value("[null]"))
+        XCTAssertEqual(fields["json/string"], .value("[\"true\"]"))
+        XCTAssertEqual(fields["json/boolean"], .value("[true]"))
+        XCTAssertEqual(fields["json/number"], .value("[1]"))
+        XCTAssertEqual(fields["json/empty/$kind"], .value("array"))
+        XCTAssertEqual(fields["json/empty/$count"], .value("0"))
+        XCTAssertNil(fields["json/notPresent"])
+    }
+
+    func testUnknownCandidateFieldIsAnUnexplainedDifference() throws {
+        let legacy = observed(["json/repository": .value("[\"owner/repo\"]")])
+        let candidate = observed([
+            "json/repository": .value("[\"owner/repo\"]"),
+            "json/assumeHealthy": .value("[true]"),
+        ])
+        let report = try SnapshotShadowComparator.compare(
+            legacy: legacy,
+            candidate: candidate,
+            resource: ResourceRef(kind: "pr-overview-cache", identifier: "owner/repo"),
+            comparedAt: Date(timeIntervalSince1970: 150)
+        )
+        XCTAssertEqual(report.unexplainedDifferences.map(\.fieldPath), ["json/assumeHealthy"])
+        XCTAssertFalse(report.isEquivalent)
+    }
+
+    func testEquivalentFieldsProduceVerificationEvent() throws {
+        let value = observed(["derived/menuBadgeCount": .value("2")])
+        let report = try SnapshotShadowComparator.compare(
+            legacy: value,
+            candidate: value,
+            resource: ResourceRef(kind: "pr-overview-cache", identifier: "owner/repo"),
+            comparedAt: Date(timeIntervalSince1970: 150)
+        )
+        XCTAssertTrue(report.isEquivalent)
+        XCTAssertEqual(report.auditEvent.category, .verification)
+    }
+}
