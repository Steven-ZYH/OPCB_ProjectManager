+++ b/Sources/ProjectControlDomain/SnapshotShadowComparison.swift
@@ -0,0 +1,115 @@
+import Foundation
+
+public struct SnapshotProjection: Codable, Equatable, Sendable {
+    public let fields: [String: ShadowFieldValue]
+
+    public init(fields: [String: ShadowFieldValue]) {
+        self.fields = fields
+    }
+}
+
+public enum CanonicalJSONFieldProjector {
+    public static func flatten(_ data: Data) throws -> [String: ShadowFieldValue] {
+        let root = try JSONSerialization.jsonObject(with: data, options: [.fragmentsAllowed])
+        var fields: [String: ShadowFieldValue] = [:]
+        try append(root, pointer: "", fields: &fields)
+        return fields
+    }
+
+    private static func append(
+        _ value: Any,
+        pointer: String,
+        fields: inout [String: ShadowFieldValue]
+    ) throws {
+        let base = pointer.isEmpty ? "json" : "json\(pointer)"
+        if let object = value as? [String: Any] {
+            fields["\(base)/$kind"] = .value("object")
+            fields["\(base)/$count"] = .value(String(object.count))
+            for key in object.keys.sorted() {
+                try append(
+                    object[key] as Any,
+                    pointer: "\(pointer)/\(escape(key))",
+                    fields: &fields
+                )
+            }
+            return
+        }
+        if let array = value as? [Any] {
+            fields["\(base)/$kind"] = .value("array")
+            fields["\(base)/$count"] = .value(String(array.count))
+            for (index, item) in array.enumerated() {
+                try append(item, pointer: "\(pointer)/\(index)", fields: &fields)
+            }
+            return
+        }
+        let encoded = try JSONSerialization.data(withJSONObject: [value], options: [.sortedKeys])
+        guard let token = String(data: encoded, encoding: .utf8) else {
+            throw DomainValidationError.invalidState("JSON leaf is not UTF-8")
+        }
+        fields[base] = .value(token)
+    }
+
+    private static func escape(_ key: String) -> String {
+        key.replacingOccurrences(of: "~", with: "~0")
+            .replacingOccurrences(of: "/", with: "~1")
+    }
+}
+
+public enum SnapshotShadowComparator {
+    public static func compare(
+        legacy: Observed<SnapshotProjection>,
+        candidate: Observed<SnapshotProjection>,
+        resource: ResourceRef,
+        comparedAt: Date,
+        allowedDifferences: [AllowedDifference] = []
+    ) throws -> ShadowComparisonReport {
+        try legacy.validate()
+        try candidate.validate()
+        var allowed: [String: String] = [:]
+        for difference in allowedDifferences {
+            guard allowed.updateValue(difference.reason, forKey: difference.fieldPath) == nil else {
+                throw DomainValidationError.duplicate("allowed difference \(difference.fieldPath)")
+            }
+        }
+
+        var legacyFields = legacy.value?.fields ?? [:]
+        var candidateFields = candidate.value?.fields ?? [:]
+        appendObservationFields(legacy, to: &legacyFields)
+        appendObservationFields(candidate, to: &candidateFields)
+        let keys = Set(legacyFields.keys).union(candidateFields.keys).sorted()
+        let differences = keys.compactMap { key -> ShadowDifference? in
+            let old = legacyFields[key] ?? .missing
+            let new = candidateFields[key] ?? .missing
+            guard old != new else { return nil }
+            return ShadowDifference(fieldPath: key, legacy: old, candidate: new, allowedReason: allowed[key])
+        }
+        let event = AuditEvent(
+            eventID: UUID(),
+            projectID: ProjectID(rawValue: "opcb"),
+            resource: resource,
+            category: .verification,
+            source: SourceRef(system: "legacy-facade", locator: "pr-overview-cache-shadow-v1"),
+            observedAt: comparedAt,
+            generation: max(legacy.generation, candidate.generation),
+            attributes: [
+                "differenceCount": String(differences.count),
+                "unexplainedDifferenceCount": String(differences.filter { $0.allowedReason == nil }.count),
+            ]
+        )
+        try event.validate()
+        return ShadowComparisonReport(resource: resource, comparedAt: comparedAt, differences: differences, auditEvent: event)
+    }
+
+    private static func appendObservationFields(
+        _ observation: Observed<SnapshotProjection>,
+        to fields: inout [String: ShadowFieldValue]
+    ) {
+        fields["observation.source.system"] = .value(observation.source.system)
+        fields["observation.source.locator"] = .value(observation.source.locator)
+        fields["observation.observedAt"] = .value(String(observation.observedAt.timeIntervalSince1970))
+        fields["observation.expiresAt"] = observation.expiresAt.map { .value(String($0.timeIntervalSince1970)) } ?? .missing
+        fields["observation.generation"] = .value(String(observation.generation))
+        fields["observation.freshness"] = .value(observation.freshness.rawValue)
+        fields["observation.errorKind"] = observation.error.map { .value($0.kind.rawValue) } ?? .missing
+    }
+}
